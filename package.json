{
  "name": "chabfu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @chabfu/client",
    "build": "npm run build -w @chabfu/client",
    "test": "npm test -w @chabfu/engine -w @chabfu/solver",
    "solve": "npm run solve -w @chabfu/solver --",
    "typecheck": "tsc -p packages/engine && tsc -p packages/solver && tsc -p apps/client",
    "economy": "npm run economy -w @chabfu/solver --"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
